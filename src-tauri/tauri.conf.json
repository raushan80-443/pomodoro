{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pomodoro",
  "version": "0.2.0",
  "identifier": "com.pomodoro.timer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pomodoro",
        "width": 780,
        "height": 540,
        "minWidth": 420,
        "minHeight": 360,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
